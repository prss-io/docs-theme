ode\u0026quot;:\u0026quot;import { GradientGlow } from \\\u0026quot;@/components/gradient-glow\\\u0026quot;;\\n\\nexport default function Page() {\\n  return \\u003cGradientGlow label=\\\u0026quot;Gradient Glow\\\u0026quot; /\\u003e;\\n}\u0026quot;,\u0026quot;language\u0026quot;:\u0026quot;tsx\u0026quot;,\u0026quot;theme\u0026quot;:\u0026quot;dark\u0026quot;,\u0026quot;showLineNumbers\u0026quot;:\u0026quot;false\u0026quot;,\u0026quot;showCopyButton\u0026quot;:\u0026quot;true\u0026quot;,\u0026quot;showHeader\u0026quot;:\u0026quot;true\u0026quot;}},\u0026quot;specializedType\u0026quot;:\u0026quot;code-block\u0026quot;}\" class=\"json-block\"\u003e\u003c/div\u003e\u003ch2\u003eProps\u003c/h2\u003e\u003ctable\u003e\u003cthead\u003e\u003ctr\u003e\u003cth\u003eProp\u003c/th\u003e\u003cth\u003eType\u003c/th\u003e\u003cth\u003eDefault\u003c/th\u003e\u003cth\u003eDescription\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003e\u003ccode\u003elabel\u003c/code\u003e\u003c/td\u003e\u003ctd\u003e\u003ccode\u003estring\u003c/code\u003e\u003c/td\u003e\u003ctd\u003e—\u003c/td\u003e\u003ctd\u003eText shown inside the glow.\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003ccode\u003espeed\u003c/code\u003e\u003c/td\u003e\u003ctd\u003e\u003ccode\u003enumber\u003c/code\u003e\u003c/td\u003e\u003ctd\u003e\u003ccode\u003e6\u003c/code\u003e\u003c/td\u003e\u003ctd\u003eAnimation duration in seconds.\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003cdiv class=\"callout\" data-type=\"info\"\u003e\u003cstrong\u003eNote:\u003c/strong\u003e This component is for illustration. Swap it for your own showcase.\u003c/div\u003e"
